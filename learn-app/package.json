{
  "name": "sdd-learn-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:spa": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=server.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:cli": "esbuild src/library/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=cli.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build": "npm run build:spa && npm run build:server && npm run build:cli",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "marked": "^15.0.12",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
